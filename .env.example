# AGRIFlow Environment Variables for Vercel Deployment

# 1. MongoDB Connection String (MongoDB Atlas Cloud Cluster)
# Example: mongodb+srv://agriflow_user:<password>@cluster0.1hfuhmn.mongodb.net/agriflow?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=

# 2. Authentication Secret Key
JWT_SECRET=agriflow-super-secret-production-key-2026

# 3. SMS Notification Service (Default: simulation)
SMS_PROVIDER=simulation
SMS_SENDER_ID=AGRFLW

# Optional: Real SMS Providers (if using Twilio / MSG91)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SMS_API_KEY=

# AGRIFlow MongoDB Connection Environment Variables

# Option 1: MongoDB Atlas (Cloud Database - Free)
# Replace with your actual connection string from MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agriflow?retryWrites=true&w=majority

# Option 2: Local MongoDB Community Server
MONGODB_URI=mongodb://127.0.0.1:27017/agriflow

PORT=5000
JWT_SECRET=agriflow-secret-key-2026
